# ─────────────────────────────────────────────────────────────
# Student OS — environment configuration
# Copy this file to `.env` and fill in what you have.
# The app RUNS WITH NO KEYS in mock mode, so you can start immediately.
# ─────────────────────────────────────────────────────────────

# --- Global mode -------------------------------------------------
# When true, every MCP server returns realistic sample data and the
# orchestrator uses a rule-based planner. No external accounts needed.
STUDENT_OS_MOCK=true

# --- LLM (optional) ---------------------------------------------
# If set, the orchestrator uses a real LLM to plan & write the briefing.
# If empty, it falls back to the deterministic rule-based planner.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- GitHub MCP server ------------------------------------------
# A classic Personal Access Token (read-only scopes are enough:
# repo:status, read:user, notifications). Leave blank to use mock data.
GITHUB_TOKEN=

# --- Google (Gmail + Calendar MCP servers) ----------------------
# OAuth 2.0 client credentials from Google Cloud Console.
# After setting these, run ONCE:  cd backend && python -m mcp_servers.common.google_auth login
# That saves a refresh token to backend/.google_token.json (git-ignored).
# See docs/SETUP.md. Leave blank to use mock data.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Codeforces MCP server --------------------------------------
# Upcoming contests need no auth. The practice reminder uses this handle.
# Leave blank to use mock data (or when STUDENT_OS_MOCK=true).
CODEFORCES_HANDLE=

# --- Backend server ---------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Caching ----------------------------------------------------
# Leave REDIS_URL blank to use the built-in in-memory cache (no setup).
# Set it (e.g. redis://localhost:6379/0) to use Redis, per the proposal.
REDIS_URL=
# How long a gathered briefing stays cached before a fresh fan-out.
CACHE_TTL_SECONDS=90

# --- Frontend ---------------------------------------------------
# Base URL the Next.js app uses to reach the backend.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
